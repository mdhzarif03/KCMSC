# Neon PostgreSQL connection string (pooled connection recommended for serverless)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Set in Phase 3 when auth is wired up. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Used only to construct the printed invite link in prisma/seed.ts and
# admin-invitation emails (once a real email provider is added).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The first administrator account, per brief §40/§22.
# Used only by the seed script to create/update this one account —
# never used to bypass the "admin created admin" invitation flow.
FIRST_ADMIN_EMAIL="mdhzarif03@gmail.com"
